{
  "name": "@asset-proxy/url-generator",
  "version": "0.1.0",
  "description": "Generate assets-proxy-compatible URL paths with optional encryption and signing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
