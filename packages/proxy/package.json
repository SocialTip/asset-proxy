{
  "name": "proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --import ./src/instrument.ts src/index.ts",
    "dev": "tsx --import ./src/instrument.ts --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@fastify/otel": "^0.18.0",
    "@google-cloud/storage": "^7.19.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.213.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.213.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/winston-transport": "^0.23.0",
    "@socialtip/asset-proxy-url-parser": "workspace:*",
    "blurhash": "^2.0.5",
    "content-disposition": "^1.0.1",
    "fastify": "^5.8.4",
    "range-parser": "^1.2.1",
    "undici": "^7.24.6",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@socialtip/asset-proxy-url-generator": "workspace:*",
    "@types/content-disposition": "^0.5.9",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/node": "^25.5.0",
    "@types/range-parser": "^1.2.7",
    "jest-image-snapshot": "^6.5.2",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
