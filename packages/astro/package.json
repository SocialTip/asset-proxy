{
  "name": "@socialtip/asset-proxy-astro",
  "version": "0.3.1",
  "description": "Astro image service for asset-proxy",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Image.astro": "./src/Image.astro",
    "./Video.astro": "./src/Video.astro"
  },
  "files": [
    "dist",
    "src/Image.astro",
    "src/Video.astro",
    "src/get-image-url.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@socialtip/asset-proxy-url-generator": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "astro": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/SocialTip/asset-proxy.git",
    "directory": "packages/astro"
  }
}
