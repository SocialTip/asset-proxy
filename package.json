{
  "name": "asset-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm --filter proxy start",
    "dev": "pnpm --filter proxy dev",
    "build": "pnpm --filter @socialtip/asset-proxy-url-parser build && pnpm --filter proxy build && pnpm --filter @socialtip/asset-proxy-url-generator build && pnpm --filter @socialtip/asset-proxy-astro build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest",
    "test:up": "docker compose up -d --build --wait",
    "test:restart": "docker compose restart asset-proxy cache-proxy",
    "test:down": "docker compose down",
    "test:coverage": "./scripts/coverage.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.1",
    "c8": "^11.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
