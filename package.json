{
  "name": "st-assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:up": "docker compose up -d --build --wait",
    "test:down": "docker compose down"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/node": "^25.5.0",
    "jest-image-snapshot": "^6.5.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
